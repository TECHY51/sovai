# ==============================================================================
# SovAI — Environment Configuration
# ==============================================================================

# Application Environment (development | production | testing)
SOVAI_ENV=development
SOVAI_VERSION=0.1.0

# Backend Server Configuration
SOVAI_BACKEND_HOST=127.0.0.1
SOVAI_BACKEND_PORT=8000
SOVAI_BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Frontend Configuration
SOVAI_FRONTEND_PORT=5173

# Local Inference Runtime Endpoints
# Target machine hosts: NVIDIA RTX 4050 6GB GPU
# Default local Ollama or vLLM endpoint:
SOVAI_INFERENCE_ENDPOINT=http://localhost:11434
SOVAI_INFERENCE_TIMEOUT_SECONDS=120

# Model Assignments
# Coding tasks
SOVAI_MODEL_CODING=qwen2.5-coder:3b
# Reasoning and general tasks
SOVAI_MODEL_REASONING=qwen3:4b
# Vision and multimodal document understanding
SOVAI_MODEL_VISION=gemma3:4b

# Python Sandbox Execution Limits
SOVAI_SANDBOX_TIMEOUT_SECONDS=15
SOVAI_SANDBOX_MAX_MEMORY_MB=512
SOVAI_SANDBOX_ALLOW_NETWORK=false
SOVAI_SANDBOX_WORKSPACE_DIR=sandbox/workspace

# Storage and Directories
SOVAI_DATA_DIR=data
SOVAI_KNOWLEDGE_BASE_DIR=knowledge_base
SOVAI_ARTIFACTS_DIR=data/artifacts
SOVAI_AUDIT_LOG_DIR=data/logs

# Security & Sovereignty
# Enforces that all outbound AI requests outside local subnet are rejected
SOVAI_STRICT_AIRGAP_MODE=true
SOVAI_AUDIT_LOGGING_ENABLED=true
